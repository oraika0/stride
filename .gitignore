# The thesis itself is not published here -- see paper/THESIS.md. Both formats
# are ignored so that dropping a copy back into paper/ cannot be committed by
# accident; delete these two lines to publish it.
paper/*.docx
paper/*.pdf

# Third-party source cloned during setup -- Mininet and Ryu, plus whatever
# install.sh pulls in beside them. Needed once to build and install; the
# installed copies are what run. See QUICKSTART step 1.
/src/

# Rebuilt from the training logs every time a reward figure is generated, in
# about a third of a second. Tracking them meant every regeneration carried a
# 36000-row diff that said nothing. NOT the same as
# paper/figures/timing/train_steps/timing_steps.csv, which is tracked on purpose:
# that one holds runs whose timings exist nowhere else.
/paper/figures/reward/train_curves.csv
/paper/figures/reward/components.csv

